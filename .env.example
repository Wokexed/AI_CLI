# Copy this file to .env and fill in your actual values.
# .env is git-ignored — never commit real keys.

# Required if AICLI_PROVIDER is groq (the default)
GROQ_API_KEY=

# Required if AICLI_PROVIDER is openai
OPENAI_API_KEY=

# Optional — which provider to use: groq (default), ollama, openai
AICLI_PROVIDER=groq

# Optional — override the default model for the selected provider
AICLI_MODEL=
